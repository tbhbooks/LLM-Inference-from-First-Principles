# Rust reference implementation (rvllm crate)
# Source this file: source spec/runners/rust.env

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RVLLM_ROOT="$SCRIPT_DIR/../../rvllm"

export RVLLM_CH01_BIN="$RVLLM_ROOT/target/debug/examples/ch01_inference_problem"
export RVLLM_CH02_BIN="$RVLLM_ROOT/target/debug/examples/ch02_architecture"
export RVLLM_CH03_BIN="$RVLLM_ROOT/target/debug/rvllm"
export RVLLM_CH04_BIN="cargo run --manifest-path $RVLLM_ROOT/Cargo.toml --example gpt2_prototype --release"
